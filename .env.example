# Copier ce fichier en `.env` et remplir les vraies valeurs.
# Le `.env` est gitignored : NE JAMAIS commit les clés.

# HuggingFace : token avec accès aux datasets gated `ministere-culture/*`
# https://huggingface.co/settings/tokens  (scope: read)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral : clé API principale (génération contrefactuels + judge)
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq : fallback gratuit (Llama 3.3 70B)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
